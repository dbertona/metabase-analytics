# Apache Superset - PS Analytics
SUPERSET_PORT=8088
SUPERSET_SECRET_KEY=change-me-in-production
SUPERSET_ADMIN_PASSWORD=change-me-in-production
# Prefijo público (NPM: https://apps.powersolution.es/analytics/)
SUPERSET_APP_ROOT=/analytics

# Azure AD / Entra (misma App Registration que Timesheet)
# Redirect Web: https://apps.powersolution.es/analytics/oauth-authorized/azure
AZURE_TENANT_ID=a18dc497-a8b8-4740-b723-65362ab7a3fb
AZURE_CLIENT_ID=3975625e-617d-410c-a166-9a3c88563344
AZURE_CLIENT_SECRET=change-me-create-in-azure-do-not-commit

# Conexión PS Analytics (PostgreSQL Supabase local)
# Usado por scripts/setup-superset-planificacion.py
PS_ANALYTICS_HOST=supabase-db
PS_ANALYTICS_PORT=5432
PS_ANALYTICS_DB=postgres
PS_ANALYTICS_USER=postgres
PS_ANALYTICS_PASSWORD=change-me
